cabal-version: 3.0
name: codegen
version: 0.1.0.0
license: BSD-3-Clause
license-file: LICENSE
author: Jonathan Merritt
maintainer: j.s.merritt@gmail.com
copyright: Copyright (C) Jonathan Merritt 2025
category: Development
build-type: Simple
extra-doc-files: CHANGELOG.md

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints
    -Wunused-type-patterns
    -Wmissing-deriving-strategies
    -Wunticked-promoted-constructors
    -Wunused-packages
    -Wderiving-defaults
    -Wtyped-holes
    -Wunused-do-bind
    -Wunused-foralls
    -Wunused-record-wildcards
    -Wwarn=deprecations
    -Wwarn=overflowed-literals
    -Wwarn=tabs
    -Wwarn=unused-top-binds

library
  import: warnings
  hs-source-dirs: src
  default-language: GHC2024
  exposed-modules:
    MyLib
    YAML
    YAML.Types

  build-depends:
    aeson ^>=2.2.3.0,
    base ^>=4.21.0.0,
    containers ^>=0.7,
    regex-tdfa ^>=1.3.2,
    template-haskell ^>=2.23,
    text ^>=2.1.3,
    text-show ^>=3.11.2,
    text-show-instances ^>=3.9.10,
    vector ^>=0.13.2.0,
    yaml ^>=0.11.11.2,

executable codegen
  import: warnings
  main-is: Main.hs
  hs-source-dirs: app
  default-language: GHC2024
  build-depends:
    base ^>=4.21.0.0,
    codegen,

test-suite codegen-test
  import: warnings
  default-language: GHC2024
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    YAML.TypesTest

  build-depends:
    aeson ^>=2.2.3.0,
    base ^>=4.21.0.0,
    bytestring ^>=0.12.2.0,
    codegen,
    hedgehog >=1.4,
    tasty >=1.4,
    tasty-hedgehog >=1.4,
    tasty-hunit >=0.10,
    text ^>=2.1.3,
    vector ^>=0.13.2.0,
    yaml ^>=0.11.11.2,